# Build PenguinBox's Linux AppImage against Ubuntu 22.04 (glibc 2.35) so the
# artifact runs on 22.04, Mint 21.x and Debian 12 -- not just 24.04+.
# An AppImage inherits the glibc of the machine that builds it, so this must be
# the OLDEST target we intend to support.
FROM docker.io/library/ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential git ninja-build pkg-config python3 python3-venv python3-pip \
      libusb-1.0-0-dev libepoxy-dev libpixman-1-dev libssl-dev libsamplerate0-dev \
      libpcap-dev libslirp-dev libvulkan-dev libwayland-dev libx11-dev libxext-dev \
      libxrandr-dev libxi-dev libxcursor-dev libxinerama-dev libxkbcommon-dev \
      libasound2-dev libpulse-dev libdrm-dev libgbm-dev libgl1-mesa-dev \
      libglu1-mesa-dev libudev-dev ca-certificates curl file zsync \
      python3-tomli python3-setuptools \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /xemu
